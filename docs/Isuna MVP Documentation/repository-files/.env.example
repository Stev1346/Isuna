# Isuna environment variable template
# Copy to .env.local for local development and provide values through approved
# environment management. Never commit real values or paste them into AI tools.

# Public Supabase configuration intentionally available to browser code.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administrative key. Exceptional trusted jobs only.
# Never prefix with PUBLIC_ and never use for normal user requests.
SUPABASE_SERVICE_ROLE_KEY=

# Application URL and environment used for safe callbacks and diagnostics.
APP_BASE_URL=
APP_ENV=development

# Stripe server credentials and configured price identifiers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOUSEHOLD_MONTHLY=
STRIPE_PRICE_HOUSEHOLD_ANNUAL=

# Resend transactional email.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=

# Sentry. PUBLIC_DSN may be intentionally exposed to browser monitoring;
# auth token is CI/server only and must never reach the client bundle.
PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Internal report-rendering authentication. Use a strong random value in
# environments where a separate renderer/job calls protected print routes.
REPORT_RENDERER_SECRET=

# Optional application-level hashing/pepper values for invitation or abuse
# signals. Define exact purpose and rotation before use; do not reuse secrets.
INVITATION_TOKEN_PEPPER=
ABUSE_SIGNAL_PEPPER=

# Feature flags should default safely and be parsed/validated by the server.
FEATURE_STRIPE_BILLING=false
FEATURE_AUTOMATED_PDF=false

# Test-only values belong in isolated test environment configuration.
# Never point tests or previews at production services/data.
